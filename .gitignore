# --- Node / Next.js (frontend) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# --- Go (backend) ---
backend/bin/
backend/*.exe
backend/*.test
backend/*.out
backend/tmp/

# --- SQLite data (real scan data must never be committed) ---
*.db
*.sqlite
*.sqlite3
backend/data/

# --- Env files (any location) ---
.env
.env.local
.env.*.local

# --- OS files ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/
.idea/

# --- AI tooling / assistant working files (never tracked) ---
.claude/
CLAUDE.md
**/*claude*

# --- Logs ---
*.log
npm-debug.log*
